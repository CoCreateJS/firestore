{
  "name": "@cocreate/firestore",
  "version": "1.5.0",
  "description": "Lightweight Google Cloud Firestore CRUD wrapper and multi-tenant state routing client for the CoCreate ecosystem.",
  "keywords": [
    "firestore",
    "firebase",
    "google-cloud-firestore",
    "nosql",
    "crud-api",
    "abstract-crud",
    "database-abstraction",
    "multi-tenant",
    "multi-tenant-routing",
    "realtime-sync",
    "state-synchronization"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "webpack --config webpack.config.js",
    "build": "webpack --mode=production --config webpack.config.js",
    "dev": "webpack --config webpack.config.js --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CoCreate-app/CoCreate-firestore.git"
  },
  "author": "CoCreate LLC",
  "license": "AGPL-3.0",
  "bugs": {
    "url": "https://github.com/CoCreate-app/CoCreate-firestore/issues"
  },
  "homepage": "https://cocreate.app/docs/firestore",
  "funding": {
    "type": "GitHub Sponsors ❤",
    "url": "https://github.com/sponsors/CoCreate-app"
  },
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./dist": "./dist/firestore.js",
    "./installer": "./installer/firestore.installer.js"
  },
  "devDependencies": {
    "@cocreate/webpack": "^1.7.0"
  },
  "dependencies": {
    "@cocreate/utils": "^1.50.0",
    "@google-cloud/firestore": "^7.5.0"
  }
}